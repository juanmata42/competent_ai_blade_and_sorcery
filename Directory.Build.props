<Project>
  <PropertyGroup>
    <!-- Folder with the game's managed assemblies. Override with env var BAS_MANAGED or -p:GameManaged=... -->
    <GameManaged Condition="'$(GameManaged)' == '' And '$(BAS_MANAGED)' != ''">$(BAS_MANAGED)</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == ''">D:\SteamLibrary\steamapps\common\Blade &amp; Sorcery\BladeAndSorcery_Data\Managed</GameManaged>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Version>0.6.0</Version>
  </PropertyGroup>
</Project>
